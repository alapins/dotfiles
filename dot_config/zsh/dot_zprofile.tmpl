# this file is installed as ~/.zprofile for newly created users

# prepend ~/.local/bin and ~/bin to $PATH unless it is already there
if ! [[ "$PATH" =~ "$HOME/bin" ]]
then
    PATH="$HOME/bin:$PATH"
fi
if ! [[ "$PATH" =~ "$HOME/.local/bin:" ]]
then
    PATH="$HOME/.local/bin:$PATH"
fi
export PATH
{{- if .isDarwin }}
# Homebrew env. On Linux the bluebuild image already sets this up system-wide;
# on macOS nothing does, so brew's bin/ would be missing from PATH entirely.
if [ -x "{{ .brewPrefix }}/bin/brew" ]; then
    eval "$("{{ .brewPrefix }}/bin/brew" shellenv)"
fi
{{- end }}
