function y() {
	local tmp="$(mktemp -t "yazi-cwd.XXXXXX")" cwd
	command yazi "$@" --cwd-file="$tmp"
	IFS= read -r -d '' cwd < "$tmp"
	[ "$cwd" != "$PWD" ] && [ -d "$cwd" ] && builtin cd -- "$cwd"
	rm -f -- "$tmp"
}

alias md=mkdir -p
alias v=nvim
alias lv=y
alias lg=lazygit
alias cm=chezmoi
alias am="$HOME/.local/bin/cm"   # cass memory system (its binary is named `cm`, which `cm` aliases to chezmoi shadows)

# Carapace config
fpath=(${ZDOTDIR:-$HOME/.config/zsh}/completions $fpath)  # native compdef completions (e.g. _codex) loaded by compinit below
autoload -U compinit && compinit
export CARAPACE_BRIDGES='zsh,fish,bash,inshellisense' # optional
zstyle ':completion:*' format $'\e[2;37mCompleting %d\e[m'
command -v carapace >/dev/null && source <(carapace _carapace)


command -v starship >/dev/null && eval "$(starship init zsh)"

_cursor_normal() { printf '\e[2 q\e]12;#e4e4e4\a'; }
_cursor_insert() { printf '\e[6 q\e]12;#88aaff\a'; }

zle-keymap-select() {
  [[ $KEYMAP == vicmd || $1 == block ]] && _cursor_normal || _cursor_insert
  (( $+functions[starship_zle-keymap-select] )) && starship_zle-keymap-select "$@"
}
zle-line-init()   { _cursor_insert; }
zle-line-finish() { _cursor_normal; }

zle -N zle-keymap-select
zle -N zle-line-init
zle -N zle-line-finish
{{ if .isLinux -}}
### bling.sh source start
test -f /usr/share/ublue-os/bling/bling.sh && source /usr/share/ublue-os/bling/bling.sh
### bling.sh source end

# In Seance, the AppImage runtime replaces argv[0] with the AppImage path for
# all exec'd processes. The ~/.local/bin/mise wrapper fixes this for the initial
# activation, but the hooks bling generates use the hardcoded linuxbrew path.
# Override them here so hook-env calls also use exec -a mise.
if [[ -n "$SEANCE_SHELL_INTEGRATION" ]]; then
  _mise_hook() {
    eval "$(exec -a mise {{ .brewPrefix }}/bin/mise hook-env -s zsh)"
  }
  _mise_hook_precmd() {
    if [[ "${__MISE_ZSH_CHPWD_RAN:-0}" == "1" ]]; then
      export __MISE_ZSH_CHPWD_RAN=0
      return
    fi
    eval "$(exec -a mise {{ .brewPrefix }}/bin/mise hook-env -s zsh --reason precmd)"
  }
  _mise_hook_chpwd() {
    export __MISE_ZSH_CHPWD_RAN=1
    eval "$(exec -a mise {{ .brewPrefix }}/bin/mise hook-env -s zsh --reason chpwd)"
  }
fi
{{ else -}}
# macOS has no ublue bling and no Seance AppImage runtime, so neither the
# bling.sh source nor the mise argv[0] workaround applies. mise activates
# normally here:
command -v mise >/dev/null && eval "$(mise activate zsh)"
{{ end -}}
autoload bashcompinit
bashcompinit
{{ if .isLinux -}}
# appman is Linux-only (rootless AppImage manager). Guarded so a missing file
# can't abort .zshrc.
_appman_comp="$HOME/.local/share/bash-completion/completions/appman"
[[ -r $_appman_comp ]] && source "$_appman_comp"
unset _appman_comp
{{ end -}}

# direnv: per-directory env, loads .env via `dotenv` in .envrc
command -v direnv >/dev/null && eval "$(direnv hook zsh)"
