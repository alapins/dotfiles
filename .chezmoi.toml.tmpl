# chezmoi's own config, generated by `chezmoi init`.
#
# This exists so a second machine (macOS) gets correct absolute paths without
# hand-editing ~/.config/chezmoi/chezmoi.toml. Everything OS-dependent that
# templates need is computed once here and exposed under [data].
#
# Regenerate after editing:  chezmoi init
# Preview without writing:   chezmoi execute-template --init < .chezmoi.toml.tmpl

{{- /* Homebrew prefix: Linuxbrew, Apple Silicon, or Intel mac. */ -}}
{{- $brewPrefix := "/home/linuxbrew/.linuxbrew" -}}
{{- if eq .chezmoi.os "darwin" -}}
{{-   if eq .chezmoi.arch "arm64" -}}
{{-     $brewPrefix = "/opt/homebrew" -}}
{{-   else -}}
{{-     $brewPrefix = "/usr/local" -}}
{{-   end -}}
{{- end -}}

{{- /* Dropbox root. Aurora is an ostree image where $HOME is /var/home/alex;
       on macOS Dropbox lives under the real home directory. */ -}}
{{- $dropbox := "/var/home/alex/Dropbox" -}}
{{- if eq .chezmoi.os "darwin" -}}
{{-   $dropbox = printf "%s/Dropbox" .chezmoi.homeDir -}}
{{- end }}

[data]
    brewPrefix = {{ $brewPrefix | quote }}
    dropbox    = {{ $dropbox | quote }}
    isLinux    = {{ eq .chezmoi.os "linux" }}
    isDarwin   = {{ eq .chezmoi.os "darwin" }}

[keepassxc]
    database = {{ printf "%s/Accounts/Passwords.kdbx" $dropbox | quote }}
